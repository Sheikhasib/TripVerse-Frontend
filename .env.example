# Only accessible from server components / server functions
# Base URL of the deployed TripVerse backend API
BACKEND_API_URL=http://localhost:4000

# Accessible from client & server components / server functions
# Must match BACKEND_API_URL (exposed client-side for public data calls)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000

# JWT secrets used by proxy.ts (Step 4) to verify tokens without calling the
# backend on every request. MUST match the backend's JWT_ACCESS_SECRET /
# JWT_REFRESH_SECRET exactly, otherwise every token is rejected and all
# dashboard routes redirect to /login.
JWT_ACCESS_SECRET=replace_with_the_same_value_as_backend
JWT_REFRESH_SECRET=replace_with_the_same_value_as_backend

# Cloudinary cloud name used by next-cloudinary for package image display
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Google OAuth (GIS) — used by the login page's Google button to obtain an idToken,
# sent to POST /api/auth/google. Must match the backend's GOOGLE_CLIENT_ID (its
# audience). Optional — the button is hidden when unset.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
